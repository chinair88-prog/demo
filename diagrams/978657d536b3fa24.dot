digraph G {
rankdir=LR;
graph [bgcolor="transparent", pad="0.35", nodesep="0.34", ranksep="0.60", splines="spline"];
node [fontname="Arial", fontsize=10, shape=rect, color="#4B5D8A", penwidth=1.45, style="rounded,filled", fillcolor="#F5F6FC", fontcolor="#253150", margin="0.15,0.09"];
edge [color="#6677A5", penwidth=1.35, arrowsize=0.72];
"APPROVAL_PENDING" [label="APPROVAL PENDING"];
"CALCULATION_PENDING" [label="CALCULATION PENDING"];
"CLOSED" [label="CLOSED"];
"DISPUTED" [label="DISPUTED"];
"OBLIGATION_OPEN" [label="OBLIGATION OPEN"];
"PARTIALLY_SETTLED" [label="PARTIALLY SETTLED"];
"RECONCILIATION_REQUIRED" [label="RECONCILIATION REQUIRED"];
"REPORTED" [label="REPORTED"];
"SETTLED" [label="SETTLED"];
"SETTLEMENT_PENDING" [label="SETTLEMENT PENDING"];
"__start_0" [shape=circle, width=0.14, fixedsize=true, label="", fillcolor="#30476F", color="#30476F", style=filled];
"__start_0" -> "OBLIGATION_OPEN";
"OBLIGATION_OPEN" -> "CALCULATION_PENDING";
"CALCULATION_PENDING" -> "APPROVAL_PENDING";
"APPROVAL_PENDING" -> "SETTLEMENT_PENDING";
"SETTLEMENT_PENDING" -> "PARTIALLY_SETTLED";
"PARTIALLY_SETTLED" -> "SETTLED";
"SETTLED" -> "RECONCILIATION_REQUIRED";
"RECONCILIATION_REQUIRED" -> "DISPUTED";
"DISPUTED" -> "REPORTED";
"REPORTED" -> "CLOSED";
}