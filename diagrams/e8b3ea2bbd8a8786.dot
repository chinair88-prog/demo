digraph G {
rankdir=LR;
graph [bgcolor="transparent", pad="0.35", nodesep="0.34", ranksep="0.60", splines="spline"];
node [fontname="Arial", fontsize=10, shape=rect, color="#4B5D8A", penwidth=1.45, style="rounded,filled", fillcolor="#F5F6FC", fontcolor="#253150", margin="0.15,0.09"];
edge [color="#6677A5", penwidth=1.35, arrowsize=0.72];
"APPOINTMENT_PENDING" [label="APPOINTMENT PENDING"];
"ARRIVED" [label="ARRIVED"];
"CLOSED" [label="CLOSED"];
"COUNTING" [label="COUNTING"];
"DISCREPANCY" [label="DISCREPANCY"];
"INSPECTION" [label="INSPECTION"];
"QUARANTINED" [label="QUARANTINED"];
"RECEIVED" [label="RECEIVED"];
"REJECTED" [label="REJECTED"];
"SCHEDULED" [label="SCHEDULED"];
"UNLOADING" [label="UNLOADING"];
"__start_0" [shape=circle, width=0.14, fixedsize=true, label="", fillcolor="#30476F", color="#30476F", style=filled];
"__start_0" -> "APPOINTMENT_PENDING";
"APPOINTMENT_PENDING" -> "SCHEDULED";
"SCHEDULED" -> "ARRIVED";
"ARRIVED" -> "UNLOADING";
"UNLOADING" -> "COUNTING";
"COUNTING" -> "INSPECTION";
"INSPECTION" -> "DISCREPANCY";
"DISCREPANCY" -> "QUARANTINED";
"QUARANTINED" -> "RECEIVED";
"RECEIVED" -> "REJECTED";
"REJECTED" -> "CLOSED";
}