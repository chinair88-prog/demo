digraph G {
rankdir=LR;
graph [bgcolor="transparent", pad="0.35", nodesep="0.34", ranksep="0.60", splines="spline"];
node [fontname="Arial", fontsize=10, shape=rect, color="#4B5D8A", penwidth=1.45, style="rounded,filled", fillcolor="#F5F6FC", fontcolor="#253150", margin="0.15,0.09"];
edge [color="#6677A5", penwidth=1.35, arrowsize=0.72];
"ACKNOWLEDGED" [label="ACKNOWLEDGED"];
"ACKNOWLEDGEMENT_PENDING" [label="ACKNOWLEDGEMENT PENDING"];
"AMENDMENT_PENDING" [label="AMENDMENT PENDING"];
"APPROVAL_PENDING" [label="APPROVAL PENDING"];
"APPROVED" [label="APPROVED"];
"CANCELLED" [label="CANCELLED"];
"CLOSED" [label="CLOSED"];
"DRAFT" [label="DRAFT"];
"FULFILLED" [label="FULFILLED"];
"ISSUED" [label="ISSUED"];
"PARTIALLY_FULFILLED" [label="PARTIALLY FULFILLED"];
"REJECTED" [label="REJECTED"];
"__start_0" [shape=circle, width=0.14, fixedsize=true, label="", fillcolor="#30476F", color="#30476F", style=filled];
"__start_0" -> "DRAFT";
"DRAFT" -> "APPROVAL_PENDING";
"APPROVAL_PENDING" -> "APPROVED";
"APPROVED" -> "ISSUED";
"ISSUED" -> "ACKNOWLEDGEMENT_PENDING";
"ACKNOWLEDGEMENT_PENDING" -> "ACKNOWLEDGED";
"ACKNOWLEDGED" -> "REJECTED";
"REJECTED" -> "AMENDMENT_PENDING";
"AMENDMENT_PENDING" -> "PARTIALLY_FULFILLED";
"PARTIALLY_FULFILLED" -> "FULFILLED";
"FULFILLED" -> "CANCELLED";
"CANCELLED" -> "CLOSED";
}