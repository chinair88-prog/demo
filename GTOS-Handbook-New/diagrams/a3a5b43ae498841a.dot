digraph G {
rankdir=LR;
graph [bgcolor="transparent", pad="0.35", nodesep="0.34", ranksep="0.60", splines="spline"];
node [fontname="Arial", fontsize=10, shape=rect, color="#4B5D8A", penwidth=1.45, style="rounded,filled", fillcolor="#F5F6FC", fontcolor="#253150", margin="0.15,0.09"];
edge [color="#6677A5", penwidth=1.35, arrowsize=0.72];
"AMENDMENT_PENDING" [label="AMENDMENT PENDING"];
"BOOKING_REQUESTED" [label="BOOKING REQUESTED"];
"CANCELLED" [label="CANCELLED"];
"CONFIRMATION_PENDING" [label="CONFIRMATION PENDING"];
"CONFIRMED" [label="CONFIRMED"];
"FAILED" [label="FAILED"];
"OPTIONS_RECEIVED" [label="OPTIONS RECEIVED"];
"OPTIONS_REQUESTED" [label="OPTIONS REQUESTED"];
"REQUIREMENT_READY" [label="REQUIREMENT READY"];
"SELECTION_PENDING" [label="SELECTION PENDING"];
"__start_0" [shape=circle, width=0.14, fixedsize=true, label="", fillcolor="#30476F", color="#30476F", style=filled];
"__start_0" -> "REQUIREMENT_READY";
"REQUIREMENT_READY" -> "OPTIONS_REQUESTED";
"OPTIONS_REQUESTED" -> "OPTIONS_RECEIVED";
"OPTIONS_RECEIVED" -> "SELECTION_PENDING";
"SELECTION_PENDING" -> "BOOKING_REQUESTED";
"BOOKING_REQUESTED" -> "CONFIRMATION_PENDING";
"CONFIRMATION_PENDING" -> "CONFIRMED";
"CONFIRMED" -> "AMENDMENT_PENDING";
"AMENDMENT_PENDING" -> "CANCELLED";
"CANCELLED" -> "FAILED";
}