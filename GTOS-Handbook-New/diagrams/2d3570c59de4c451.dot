digraph G {
rankdir=LR;
graph [bgcolor="transparent", pad="0.35", nodesep="0.34", ranksep="0.60", splines="spline"];
node [fontname="Arial", fontsize=10, shape=rect, color="#4B5D8A", penwidth=1.45, style="rounded,filled", fillcolor="#F5F6FC", fontcolor="#253150", margin="0.15,0.09"];
edge [color="#6677A5", penwidth=1.35, arrowsize=0.72];
"AUTHORIZED" [label="AUTHORIZED"];
"CLAIM_PENDING" [label="CLAIM PENDING"];
"CLOSED" [label="CLOSED"];
"DISPUTED" [label="DISPUTED"];
"ELIGIBILITY_REVIEW" [label="ELIGIBILITY REVIEW"];
"INSPECTION_PENDING" [label="INSPECTION PENDING"];
"RECEIVED" [label="RECEIVED"];
"REFUNDED" [label="REFUNDED"];
"REFUND_PENDING" [label="REFUND PENDING"];
"REJECTED" [label="REJECTED"];
"REQUESTED" [label="REQUESTED"];
"RESOLVED" [label="RESOLVED"];
"RETURN_IN_TRANSIT" [label="RETURN IN TRANSIT"];
"__start_0" [shape=circle, width=0.14, fixedsize=true, label="", fillcolor="#30476F", color="#30476F", style=filled];
"__start_0" -> "REQUESTED";
"REQUESTED" -> "ELIGIBILITY_REVIEW";
"ELIGIBILITY_REVIEW" -> "AUTHORIZED";
"AUTHORIZED" -> "REJECTED";
"REJECTED" -> "RETURN_IN_TRANSIT";
"RETURN_IN_TRANSIT" -> "RECEIVED";
"RECEIVED" -> "INSPECTION_PENDING";
"INSPECTION_PENDING" -> "REFUND_PENDING";
"REFUND_PENDING" -> "REFUNDED";
"REFUNDED" -> "CLAIM_PENDING";
"CLAIM_PENDING" -> "DISPUTED";
"DISPUTED" -> "RESOLVED";
"RESOLVED" -> "CLOSED";
}